{
  "name": "dinosaur-run",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ci:eslint": "eslint -f json src -o ./.ci/eslint.json",
    "lint": "eslint . && stylelint \"**/*.{css,less,scss}\"",
    "lint:fix": "prettier --write . && eslint --fix . && stylelint --fix \"**/*.{css,less,scss}\"",
    "start": "pnpm run dev",
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "prettier": "prettier-config-ali",
  "stylelint": {
    "extends": [
      "stylelint-config-ali",
      "stylelint-prettier/recommended"
    ]
  },
  "dependencies": {
    "animate.css": "^4.1.1",
    "pinia": "^3.0.2",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "eslint": "^9.27.0",
    "eslint-config-ali": "^16.3.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "prettier": "^3.5.3",
    "prettier-config-ali": "^1.3.4",
    "sass-embedded": "^1.89.0",
    "stylelint": "^16.19.1",
    "stylelint-config-ali": "^2.1.2",
    "stylelint-prettier": "^5.0.3",
    "vite-plugin-babel": "^1.3.1",
    "vite-plugin-svg-icons": "^2.0.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/tsconfig": "^0.7.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.8"
  }
}
